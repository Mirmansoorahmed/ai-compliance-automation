{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-semantic-guardrails-eu/schemas/interpretation.schema.json",
  "title": "Interpretation",
  "description": "A versioned, human-authored reading of a requirement (DESIGN.md §5.2). The only source of a hard deny. Immutable once approved; a change is a new version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "requirement_id", "decision", "owner", "reason", "effective_from", "review_by", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INT-[0-9]{4}-[0-9]{3}$"
    },
    "version": {
      "type": "integer"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[A-Za-z0-9-]+$"
    },
    "decision": {
      "type": "string",
      "enum": ["confirmed_prohibited_pattern", "not_in_scope", "needs_review"]
    },
    "owner": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "rule_ref": {
      "type": "string"
    },
    "eval_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved"]
    }
  }
}
