{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-semantic-guardrails-eu/schemas/use-case.schema.json",
  "title": "use-case.yaml",
  "description": "One AI feature's declaration: intended purpose, affected persons, data categories (incl. GDPR Art. 9 special categories), decision effect, human oversight, Annex III area, owner, and links to the artefacts the deploy gate checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "intended_purpose", "ai_system", "role", "annex_iii", "owner"],
  "properties": {
    "id": { "type": "string", "pattern": "^uc-[a-z0-9-]+$" },
    "title": { "type": "string", "pattern": "\\S" },
    "intended_purpose": { "type": "string", "pattern": "\\S" },
    "ai_system": { "type": "boolean" },
    "role": { "type": "string", "enum": ["provider", "deployer", "both"] },
    "annex_iii": { "type": "array", "items": { "type": "string" } },
    "art6_3_exception": { "type": "boolean" },
    "profiling": { "type": "boolean" },
    "decision_effect": { "type": "string", "enum": ["none", "assists", "solely_automated"] },
    "affected_persons": { "type": "array", "items": { "type": "string" } },
    "personal_data": { "type": "array", "items": { "type": "string" } },
    "special_categories": { "type": "array", "items": { "type": "string" } },
    "countries_of_processing": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string", "pattern": "\\S" },
    "human_overseer": { "type": "string" },
    "artefacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_management": { "type": ["string", "null"] },
        "dpia": { "type": ["string", "null"] },
        "fria": { "type": ["string", "null"] },
        "oversight_plan": { "type": ["string", "null"] },
        "eval_report": { "type": ["string", "null"] },
        "worker_information": { "type": ["string", "null"] }
      }
    },
    "approvals": { "type": "array" }
  }
}
