{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-compliance-automation/schemas/requirement.schema.json",
  "title": "Requirement",
  "description": "A versioned legal/ISMS obligation (DESIGN.md §5.1). Titles are in our own words; never copied statute or standard text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "citation", "title", "mode", "owner", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[A-Za-z0-9-]+$"
    },
    "source": {
      "type": "string",
      "enum": ["EU AI Act", "ISO/IEC 27001:2022"]
    },
    "citation": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["auto", "human", "hybrid"]
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "retired"]
    },
    "elements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rule_ref": {
      "type": "string"
    }
  }
}
