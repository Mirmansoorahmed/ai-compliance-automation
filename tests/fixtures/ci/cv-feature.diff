+"""CV pre-screening: score applicants and propose a shortlist for a recruiter."""
+
+
+def score_applicants(applications):
+    # Rank applications on objective, declared features; a human recruiter
+    # makes the final shortlist decision (assists, not solely automated).
+    ranked = sorted(applications, key=lambda a: a["score"], reverse=True)
+    return ranked[:20]
